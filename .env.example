# KrishiConnect Environment Configuration
# ----------------------------------------------------
# KrishiConnect runs completely as a client-side web application
# using browser localStorage for demonstration data persistence.
#
# No external paid APIs, backend servers, or secret keys are required.
#
# (Optional) Port for local development (defaults to 3000 if not specified):
PORT=3000

# (Optional) Base path if deploying to a custom subdirectory on a web host:
# VITE_BASE_PATH="./"
